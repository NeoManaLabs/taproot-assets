        }
      }
    },
    "pocketuniverserpcComputeSigHashRequest": {
      "type": "object",
      "properties": {
        "funded_psbt": {
          "type": "string",
          "format": "byte",
          "title": "The funded virtual PSBT"
        }
      }
    },
    "pocketuniverserpcComputeSigHashResponse": {
      "type": "object",
      "properties": {
        "sighashes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "byte"
          },
