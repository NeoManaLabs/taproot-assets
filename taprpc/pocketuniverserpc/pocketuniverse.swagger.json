  "paths": {
    "/v1/taproot-assets/pocket-universe/apply-signature": {
      "post": {
        "summary": "ApplyExternalSignature applies an externally-generated signature to\na virtual PSBT.",
        "operationId": "PocketUniverse_ApplyExternalSignature",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pocketuniverserpcApplyExternalSigResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/pocketuniverserpcApplyExternalSigRequest"
            }
          }
        ],
        "tags": [
          "PocketUniverse"
        ]
      }
    },
    "/v1/taproot-assets/pocket-universe/compute-sighash": {
      "post": {
        "summary": "ComputeVirtualTxSigHash computes the sighash that needs to be signed\nfor a virtual transaction, allowing external signing.",
        "operationId": "PocketUniverse_ComputeVirtualTxSigHash",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/pocketuniverserpcComputeSigHashResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/pocketuniverserpcComputeSigHashRequest"
            }
          }
        ],
        "tags": [
          "PocketUniverse"
        ]
      }
    }
  },
  "definitions": {
    "pocketuniverserpcApplyExternalSigRequest": {
      "type": "object",
      "properties": {
        "funded_psbt": {
          "type": "string",
          "format": "byte",
          "title": "The funded virtual PSBT"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "byte"
          },
          "title": "The schnorr signatures, one per input"
        }
      }
    },
    "pocketuniverserpcApplyExternalSigResponse": {
